# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js and build outputs
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

