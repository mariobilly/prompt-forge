# Optional. Copy to .env.local and fill in, or type your keys into the app's Settings page instead
# (a key saved in Settings wins). Keys are only sent to their own service.

# Claude, through your own Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# Perplexity, for docs research and model suggestions (https://console.perplexity.ai/project/keys)
PERPLEXITY_API_KEY=

# "api" (default) or "claude-code" to use the Claude Code CLI you installed and logged in to
PF_CLAUDE_PROVIDER=
# Path to the Claude Code executable, if it isn't in ~/.local/bin or on your PATH
PF_CLAUDE_BIN=

# Where the database and settings live (default: %LOCALAPPDATA%\PromptForge)
PROMPTFORGE_DATA_DIR=

# Model overrides
PF_WRITER_MODEL=
PF_FAST_MODEL=
PF_RESEARCH_MODEL=
PF_DEEP_RESEARCH_MODEL=
